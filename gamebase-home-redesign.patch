+          {ends && (
+            <span
+              className={[
+                'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs font-bold',
+                soon ? 'bg-[var(--accent)] text-[var(--on-accent)]' : 'bg-surface-2 text-ink',
