{
  "name": "@rj/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrateCli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@rj/shared": "0.1.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
